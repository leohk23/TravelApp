# Template for .env. Copy to .env and fill in; .env is gitignored.
#
# Used only by scripts in tools/ at build time. Nothing here is ever bundled
# into the app: the deployed site has no keys and makes no authenticated calls.
#
# Node reads this natively, no dependency needed:
#   node --env-file=.env tools/make-jp-fares.mjs
#
# ODPT (Open Data Platform for Transportation, Japan)
# Register at https://developer.odpt.org — paste the access token after the =
# Gives station-to-station fares for 13 Tokyo operators: Tokyo Metro, Toei,
# Keio, Keikyu, Tokyu, Tobu, Seibu, Sotetsu, TWR, Yurikamome, Tama Monorail,
# Tsukuba Express and Yokohama Municipal. JR East does not publish here.
ODPT_KEY=your-token-here
